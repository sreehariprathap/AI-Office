# ---- Realtime mode: the AI Workforce office feed (the only real-time source)
WORKFORCE_URL=https://161-35-48-14.sslip.io/api/office/snapshot
# Same value as OFFICE_FEED_TOKEN on the workforce backend
WORKFORCE_TOKEN=

# ---- Admin token: required to change anything from a deployed UI (paste it into the 🔒 prompt).
# Locally, `next dev` hands a generated token to the browser automatically.
HUB_ADMIN_TOKEN=

# ---- Storage on Vercel: add the Upstash Redis integration (sets these for you).
# Without them, local dev uses data/hub.json and a Vercel deployment falls back to non-persistent memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- First boot without the demo world
# HUB_SEED=none
